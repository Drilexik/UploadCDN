# .gitignore - Prevent sensitive files from being committed

# Dependencies
node_modules/
.npm
.yarn

# Build and runtime
.next/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
out/
dist/

# Uploads directory
uploads/
data/

# Runtime logs (nginx access/error logs bind-mounted from the container)
logs/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Security
private/
secrets/
certs/
.ssh/

# Docker
.dockerignore
docker-compose.override.yml

# Testing
coverage/
.nyc_output/

# Misc
.cache/
.turbo/
.puma_history
.viminfo
