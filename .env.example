# =============================================================================
#  UploadCDN environment configuration
#  Do NOT commit the real .env file. Generate it with ./buildcdnapp or
#  ./redeploycdnweb — those create a strong credential for you automatically.
# =============================================================================

# PREFERRED credential: salted scrypt hash of the admin password.
# Format: <saltHex>:<hashHex>. The plaintext password is never stored.
# Generated for you by the deploy scripts — do not hand-edit.
ADMIN_PASSWORD_HASH=

# LEGACY (optional): plaintext admin password. Only used when ADMIN_PASSWORD_HASH
# is empty. Must be 16+ chars, mixed case, numbers and symbols. Leave blank when
# using a hash above.
ADMIN_PASSWORD=

# Public base URL — used to generate CDN links. Must match your domain.
BASE_URL=https://upload.example.com

# Port the Next.js server listens on (kept internal behind nginx).
PORT=3000

# Where uploaded files are stored inside the container (mapped to a volume).
UPLOADS_DIR=/app/uploads

# Always production for a real deployment.
NODE_ENV=production
