# CRITICAL: Set to a strong, unique password
# Minimum 16 characters with uppercase, lowercase, numbers, and special characters
ADMIN_PASSWORD=YourSecurePassword123!@#

# Base URL for file access
BASE_URL=https://upload.drilex.cz

# Port (default: 3000)
PORT=3000

# Upload directory
UPLOADS_DIR=/app/uploads

# Security: Set NODE_ENV to production
NODE_ENV=production
